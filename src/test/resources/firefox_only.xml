<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Firefox Only" parallel="false" thread-count="1">

    <listeners>
        <listener class-name="core.MethodListener"/>
    </listeners>

    <parameter name="server" value="dev"/>

    <test name="Run on firefox browser">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.orangehrm.Level_26_Environment"/>
        </classes>
    </test>

</suite>
