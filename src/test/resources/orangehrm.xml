<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM-UI Automation Testing" parallel="tests" thread-count="3">
<!--    <parameter name="appUrl" value="https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"></parameter>-->

    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>

    <parameter name="server" value="dev"></parameter>

    <test name="Run on firefox browser">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.orangehrm.Level_26_Environment"/>
        </classes>
    </test>

    <test name="Run on chrome browser">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.orangehrm.Level_26_Environment"/>
        </classes>
    </test>

    <test name="Run on edge browser">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.orangehrm.Level_26_Environment"/>
        </classes>
    </test>
</suite>